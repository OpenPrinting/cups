<div class="printer-detail-header">
  <div class="detail-title-line">
    <span class="prompt-marker">&gt;_</span>
    <h1 class="title-inline"><a href="{printer_uri_supported}" class="queue-name">{printer_name}</a></h1>
    <div class="status-pill-group">
      {printer_state=3?<span class="status-pill idle">&bull; Idle</span>:{printer_state=4?<span class="status-pill processing">&bull; Processing</span>:<span class="status-pill paused">&FilledSmallSquare; Paused</span>}}
      {printer_is_accepting_jobs=0?<span class="status-pill stopped">&times; Rejecting Jobs</span>:<span class="status-pill idle">&check; Accepting Jobs</span>}
      {server_is_sharing_printers=0?<span class="status-pill stopped">Not Shared</span>:{printer_is_shared=0?<span class="status-pill stopped">Not Shared</span>:<span class="status-pill idle">Shared</span>}}
      {default_name={printer_name}?<span class="status-pill default">&starf; Server Default</span>:}
    </div>
  </div>

  <div class="printer-actions-toolbar">
    <form method="POST" action="{printer_uri_supported}" name="maintenance">
      <input type="hidden" name="org.cups.sid" value="{$org.cups.sid}">
      <select name="OP" onchange="document.maintenance.submit();" aria-label="Maintenance Actions">
        <option value="">Maintenance &hellip;</option>
        <option value="print-test-page">Print Test Page</option>
        {printer_commands~.*Clean.*?<option value="clean-print-heads">Clean Print Heads</option>:}
        {printer_commands~.*PrintSelfTestPage.*?<option value="print-self-test-page">Print Self Test Page</option>:}
        {printer_state=5?<option value="start-printer">Resume Printer</option>:<option value="stop-printer">Pause Printer</option>}
        {printer_is_accepting_jobs=0?<option value="accept-jobs">Accept Jobs</option>:<option value="reject-jobs">Reject Jobs</option>}
        <option value="move-jobs">Move All Jobs</option>
        <option value="cancel-jobs">Cancel All Jobs</option>
      </select>
      <noscript><input type="submit" value="Go"></noscript>
    </form>

    <form method="POST" action="{admin_uri}" name="administration">
      <input type="hidden" name="org.cups.sid" value="{$org.cups.sid}">
      <input type="hidden" name="printer_name" value="{printer_name}">
      <select name="OP" onchange="document.administration.submit();" aria-label="Administration Actions">
        <option value="">Administration &hellip;</option>
        <option value="modify-printer">Modify Printer</option>
        <option value="delete-printer">Delete Printer</option>
        <option value="set-printer-options">Set Default Options</option>
        <option value="set-as-default">Set As Server Default</option>
        <option value="set-allowed-users">Set Allowed Users</option>
      </select>
      <noscript><input type="submit" value="Go"></noscript>
    </form>
  </div>
</div>

<div class="table-container">
  <table class="indent" summary="{printer_name}">
    <tbody>
      <tr><th class="label" scope="row">Description:</th><td>{printer_info}</td></tr>
      <tr><th class="label" scope="row">Location:</th><td>{printer_location}</td></tr>
      <tr><th class="label" scope="row">Driver:</th><td><code>{printer_make_and_model}</code> ({color_supported=1?color:grayscale}{sides_supported=one-sided?:, 2-sided printing})</td></tr>
      <tr><th class="label" scope="row">Connection:</th><td><code class="mono-val">{device_uri}</code></td></tr>
      <tr><th class="label" scope="row">Defaults:</th><td><code class="mono-val">job-sheets={job_sheets_default} media={media_default?{media_default}:unknown} {sides_default?sides={sides_default}:}</code></td></tr>
      {printer_state_message?<tr><th class="label" scope="row">Message&#58;</th><td><blockquote class="printer-msg">"{printer_state_message}"</blockquote></td></tr>:}
    </tbody>
  </table>
</div>

<!-- Contextual Diagnostic Area (Root Intelligence) -->
<div class="diagnostic-assistant-mount" data-queue="{printer_name}" data-state="{printer_state}" data-message="{?printer_state_message}" data-uri="{device_uri}" data-accepting="{printer_is_accepting_jobs}">
  <noscript>
    <div class="diagnostic-panel" role="region" aria-labelledby="diag-panel-title-ns">
      <div class="diag-header">
        <span class="prompt-marker">&gt;_</span>
        <span id="diag-panel-title-ns" class="diag-title">Diagnostic Assistant [Static Local Rule]</span>
      </div>
      <div class="diag-body">
        <div class="diag-card">
          <p><strong>Observed:</strong> Queue {printer_name} in state {printer_state=3?Idle:{printer_state=4?Processing:Paused}}.</p>
          <p><strong>Verification via terminal:</strong> Run <code>lpstat -p {printer_name} -l</code> to inspect spooler details.</p>
          <pre class="cli-block"><span class="cmd-prompt">$</span> cupsenable {printer_name}</pre>
        </div>
      </div>
    </div>
  </noscript>
</div>
