	<h1>{ENV:CUPS_VERSION}</h1>
	<p>Il sistema di stampa open source, basato su standard, sviluppato da <a class="jumbolink" href="https://openprinting.github.io/" target="_blank">OpenPrinting</a> per Linux® e altri sistemi operativi Unix®-like.
	CUPS utilizza <a href="https://www.pwg.org/ipp/everywhere.html" target="_blank">IPP Everywhere™</a> per supportare la stampa su stampanti locali e di rete.</p>
      </div>
      <div class="row">
        <h2 class="title">Questo sistema</h2>
	<form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="add-printer"><input type="submit" value="Aggiungi stampante"></form>
	<form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="find-new-printers"><input type="submit" value="Rileva nuova stampante"></form>
	<form action="/jobs/" method="GET"><input type="submit" value="Gestisci Lavori"></form>
	<form action="/printers/" method="GET"><input type="submit" value="Gestisci Stampanti"></form>
	<form action="/admin/" method="GET"><input type="submit" value="Gestisci Impostazioni di Sistema"></form>
        {#alert_title=0?:<p>Avvisi:</p>
        <ul>{[alert_title]
          <li><a href="{alert_href}">{alert_title}</a></li>}
        </ul>}
      </div>
