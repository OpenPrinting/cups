{#job_id=0?
<div class="empty-state-box">
  <div class="empty-ascii">+----------------------------------------+<br>| &nbsp;[ _ ] &nbsp;No active jobs in spooler &nbsp;&nbsp;&nbsp;|<br>+----------------------------------------+</div>
  <p class="empty-text">No print jobs active or matching the selected filters.</p>
  <pre class="cli-block"><span class="cmd-prompt">$</span> lpstat -o <span class="cmd-comment"># Inspect print job queue via terminal</span></pre>
</div>
:
<div class="table-container">
<table class="list" summary="Print Jobs List">
<thead>
<tr>
  <th scope="col">ID</th>
  <th scope="col">File Name</th>
  <th scope="col">User</th>
  <th scope="col">Size</th>
  <th scope="col">Pages</th>
  <th scope="col">State</th>
  <th scope="col">Control Actions</th>
</tr>
</thead>
<tbody>
{[job_id]
<tr valign="top">
  <td><a href="{job_printer_uri}" class="queue-name">{job_printer_name}</a>-<span class="job-id">{job_id}</span>{?phone? ({phone}):}&nbsp;</td>
  <td><strong>{?job_name=?Unknown:{job_name}}</strong>&nbsp;</td>
  <td><code>{?job_originating_user_name=?Withheld:{job_originating_user_name}}</code>&nbsp;</td>
  <td class="mono-val">{job_k_octets}k&nbsp;</td>
  <td class="mono-val">{job_impressions_completed=0?&mdash;:{?job_impressions_completed}}&nbsp;</td>
  <td>
    {job_state=3?<span class="status-pill paused">&bull; Pending</span><div class="card-meta">since {?date_time_at_creation=?unknown:{date_time_at_creation}}</div>:
    {job_state=4?<span class="status-pill held">&FilledSmallSquare; Held</span><div class="card-meta">since {?date_time_at_creation=?unknown:{date_time_at_creation}}</div>:
    {job_state=5?<span class="status-pill processing">&bull; Processing</span><div class="card-meta">since {?date_time_at_processing=?unknown:{date_time_at_processing}}</div>:
    {job_state=6?<span class="status-pill stopped">&times; Stopped</span>:
    {job_state=7?<span class="status-pill stopped">&times; Canceled</span><div class="card-meta">at {?date_time_at_completed=?unknown:{date_time_at_completed}}</div>:
    {job_state=8?<span class="status-pill stopped">&times; Aborted</span>:
    <span class="status-pill idle">&check; Completed</span><div class="card-meta">at {?date_time_at_completed=?unknown:{date_time_at_completed}}</div>}}}}}}
    {job_printer_state_message?<div class="status-msg">"{job_printer_state_message}"</div>:}
  </td>
  <td>
    <div class="job-actions-group">
      {job_preserved>0?{job_state>5?
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="restart-job"><input type="hidden" name="job_id" value="{job_id}"><input type="hidden" name="job_printer_uri" value="{job_printer_uri}"><input type="submit" value="Reprint"></form>:}:}
      {job_state=4?
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="release-job"><input type="hidden" name="job_id" value="{job_id}"><input type="hidden" name="job_printer_uri" value="{job_printer_uri}"><input type="submit" value="Release"></form>:}
      {job_state=3?
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="hold-job"><input type="hidden" name="job_id" value="{job_id}"><input type="hidden" name="job_printer_uri" value="{job_printer_uri}"><input type="submit" value="Hold"></form>:}
      {job_state<7?
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="cancel-job"><input type="hidden" name="job_id" value="{job_id}"><input type="hidden" name="job_printer_uri" value="{job_printer_uri}"><input type="submit" value="Cancel"></form>
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="move-job"><input type="hidden" name="job_id" value="{job_id}"><input type="submit" value="Move"></form>:}
    </div>
  </td>
</tr>
}
</tbody>
</table>
</div>
}
