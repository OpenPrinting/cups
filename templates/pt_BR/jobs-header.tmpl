<div class="jobs-filter-toolbar">
  <div class="filter-buttons-group">
    {?which_jobs=?:<form action="{?printer_name=?/jobs:{printer_uri_supported}}" method="GET"><input type="submit" value="Mostrar trabalhos ativos" class="btn-filter"></form>}
    {?which_jobs=completed?:<form action="{?printer_name=?/jobs:{printer_uri_supported}}" method="GET"><input type="hidden" name="which_jobs" value="completed"><input type="submit" value="Mostrar trabalhos conclu&iacute;dos" class="btn-filter"></form>}
    {?which_jobs=all?:<form action="{?printer_name=?/jobs:{printer_uri_supported}}" method="GET"><input type="hidden" name="which_jobs" value="all"><input type="submit" value="Mostrar todos os trabalhos" class="btn-filter"></form>}
  </div>

  <div class="filter-order-note">
    <span class="prompt-marker">&gt;_</span> {?which_jobs=?Trabalhos ativos listados em ordem de processamento &blacktriangledown; (trabalhos retidos aparecem primeiro):{which_jobs=all?Todos os trabalhos em ordem sequencial &blacktriangledown;:Trabalhos conclu&iacute;dos em ordem decrescente &blacktriangle;}}
  </div>
</div>
