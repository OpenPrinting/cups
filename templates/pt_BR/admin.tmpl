  <div class="halves">
    <div class="admin-panel">
      <h2 class="title"><span class="prompt-marker">&gt;_</span> /admin/printers &mdash; Filas de Impress&atilde;o</h2>
      <p class="admin-panel-desc">Gerenciamento direto de dispositivos f&iacute;sicos e conex&otilde;es de rede.</p>
      <div class="server-actions-bar">
        <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="add-printer"><input type="submit" value="Adicionar impressora"></form>
        <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="find-new-printers"><input type="submit" value="Encontrar novas impressoras"></form>
        <form action="/printers/" method="GET"><input type="submit" value="Gerenciar impressoras"></form>
      </div>
    </div>

    <div class="admin-panel">
      <h2 class="title"><span class="prompt-marker">&gt;_</span> /admin/classes &mdash; Classes de Agrupamento</h2>
      <p class="admin-panel-desc">Agrupamento de m&uacute;ltiplas impressoras em uma &uacute;nica fila l&oacute;gica com balanceamento.</p>
      <div class="server-actions-bar">
        <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="add-class"><input type="submit" value="Adicionar classe"></form>
        <form action="/classes/" method="GET"><input type="submit" value="Gerenciar classes"></form>
      </div>
    </div>

    <div class="admin-panel">
      <h2 class="title"><span class="prompt-marker">&gt;_</span> /admin/jobs &mdash; Spooler de Trabalhos</h2>
      <p class="admin-panel-desc">Auditoria, cancelamento em lote, reten&ccedil;&atilde;o e libera&ccedil;&atilde;o de documentos.</p>
      <div class="server-actions-bar">
        <form action="/jobs/" method="GET"><input type="submit" value="Gerenciar trabalhos"></form>
      </div>
    </div>
  </div>

  <div class="halves">
    <div class="admin-panel">
      <h2 class="title"><span class="prompt-marker">&gt;_</span> /admin/server &mdash; Configura&ccedil;&otilde;es do Servidor CUPS</h2>

      <div class="server-actions-bar">
        <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="config-server"><input type="submit" value="Editar cupsd.conf diretamente"></form>
      </div>

      {SETTINGS_ERROR?<div class="server-alerts-box" role="alert"><p><strong>{SETTINGS_MESSAGE}</strong></p><blockquote>{SETTINGS_ERROR}</blockquote></div>:

      <form method="POST" action="/admin">
      <input type="hidden" name="org.cups.sid" value="{$org.cups.sid}">

      {ADVANCEDSETTINGS?
      <div class="settings-group">
        <div class="settings-header">
          <strong>Configura&ccedil;&otilde;es Avan&ccedil;adas do cupsd</strong> &bull; <a href="/admin/" class="disclosure-link">Ocultar avan&ccedil;adas <small>&#x25bc;</small></a>
        </div>

        <input type="hidden" name="OP" value="config-server">
        <input type="hidden" name="ADVANCEDSETTINGS" value="CHECKED">

        <div class="setting-item">
          <label><input type="checkbox" name="SHARE_PRINTERS" id="SHARE_PRINTERS" value="CHECKED" {?share_printers}> <strong>Compartilhar impressoras conectadas a este sistema</strong></label>
          <div class="setting-desc">Anuncia as filas via mDNS/DNS-SD (Bonjour/Avahi) na rede local.</div>
        </div>

        <div class="setting-item setting-indent">
          <label>M&aacute;ximo de clientes simult&acirc;neos&#58; <input type="text" name="MAX_CLIENTS" value="{?max_clients}" size="6" class="mono-val"></label>
          <div class="setting-desc">Limita descritores de socket abertos no daemon cupsd.</div>
        </div>

        <div class="setting-item setting-indent">
          <label><input type="checkbox" name="REMOTE_ANY" id="REMOTE_ANY" value="CHECKED" {?remote_any}> <strong>Permitir impress&atilde;o a partir da Internet</strong></label>
          <div class="setting-desc">Permite conex&otilde;es al&eacute;m da sub-rede local (0.0.0.0/0).</div>
        </div>

        <div class="setting-item setting-indent">
          <label><input type="checkbox" name="BROWSE_WEB_IF" id="BROWSE_WEB_IF" value="CHECKED" {?browse_web_if}> <strong>Anunciar interface web na rede</strong></label>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="REMOTE_ADMIN" id="REMOTE_ADMIN" value="CHECKED" {?remote_admin}> <strong>Permitir administra&ccedil;&atilde;o remota</strong></label>
          <div class="setting-desc">Autoriza requisi&ccedil;&otilde;es de gerenciamento via browser vindas de outros IPs.</div>
        </div>

        {have_gssapi?<div class="setting-item"><label><input type="checkbox" name="KERBEROS" id="KERBEROS" value="CHECKED" {?kerberos}> <strong>Usar autentica&ccedil;&atilde;o via Kerberos</strong> (<a href="/help/kerberos.html?TOPIC=Getting+Started">Documenta&ccedil;&atilde;o</a>)</label></div>:}

        <div class="setting-item">
          <label><input type="checkbox" name="USER_CANCEL_ANY" id="USER_CANCEL_ANY" value="CHECKED" {?user_cancel_any}> <strong>Permitir aos usu&aacute;rios cancelar qualquer trabalho</strong></label>
          <div class="setting-desc">Permite que usu&aacute;rios cancelem impress&otilde;es de outros colegas sem root.</div>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="PRESERVE_JOBS" id="PRESERVE_JOBS" value="CHECKED" {?preserve_jobs}> <strong>Preservar hist&oacute;rico de trabalhos de impress&atilde;o</strong></label>
        </div>

        <div class="setting-item setting-indent">
          <label>M&aacute;ximo de trabalhos no hist&oacute;rico (0 = ilimitado)&#58; <input type="text" name="MAX_JOBS" value="{?max_jobs}" size="6" class="mono-val"></label>
        </div>

        <div class="setting-item setting-indent">
          <label>Reter metadados dos trabalhos&#58; <input type="text" name="PRESERVE_JOB_HISTORY" value="{?preserve_job_history}" size="6" class="mono-val"></label>
        </div>

        <div class="setting-item setting-indent">
          <label>Reter c&oacute;pias dos documentos impressos&#58; <input type="text" name="PRESERVE_JOB_FILES" value="{?preserve_job_files}" size="6" class="mono-val"></label>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="DEBUG_LOGGING" id="DEBUG_LOGGING" value="CHECKED" {?debug_logging}> <strong>Salvar informa&ccedil;&atilde;o de depura&ccedil;&atilde;o detalhada (LogLevel debug)</strong></label>
          <div class="setting-desc">Essencial para an&aacute;lise de diagn&oacute;stico de falhas de filtros e drivers.</div>
        </div>

        <div class="setting-item setting-indent">
          <label>Tamanho m&aacute;ximo do log de erro&#58; <input type="text" name="MAX_LOG_SIZE" value="{?max_log_size}" size="6" class="mono-val"></label>
        </div>
      </div>

      :
      <div class="settings-group">
        <div class="settings-header">
          <strong>Configura&ccedil;&otilde;es B&aacute;sicas do cupsd</strong> &bull; <a href="/admin/?ADVANCEDSETTINGS=YES" class="disclosure-link">Mostrar avan&ccedil;adas <small>&#x25b6;</small></a>
        </div>

        <input type="hidden" name="OP" value="config-server">

        <div class="setting-item">
          <label><input type="checkbox" name="SHARE_PRINTERS" id="SHARE_PRINTERS" value="CHECKED" {?share_printers}> <strong>Compartilhar impressoras conectadas a este sistema</strong></label>
          <div class="setting-desc">Publica as filas na rede local via mDNS.</div>
        </div>

        <div class="setting-item setting-indent">
          <label><input type="checkbox" name="REMOTE_ANY" id="REMOTE_ANY" value="CHECKED" {?remote_any}> <strong>Permitir impress&atilde;o a partir da Internet</strong></label>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="REMOTE_ADMIN" id="REMOTE_ADMIN" value="CHECKED" {?remote_admin}> <strong>Permitir administra&ccedil;&atilde;o remota</strong></label>
        </div>

        {have_gssapi?<div class="setting-item"><label><input type="checkbox" name="KERBEROS" id="KERBEROS" value="CHECKED" {?kerberos}> <strong>Usar autentica&ccedil;&atilde;o via Kerberos</strong> (<a href="/help/kerberos.html?TOPIC=Getting+Started">Documenta&ccedil;&atilde;o</a>)</label></div>:}

        <div class="setting-item">
          <label><input type="checkbox" name="USER_CANCEL_ANY" id="USER_CANCEL_ANY" value="CHECKED" {?user_cancel_any}> <strong>Permitir aos usu&aacute;rios cancelar qualquer trabalho</strong></label>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="DEBUG_LOGGING" id="DEBUG_LOGGING" value="CHECKED" {?debug_logging}> <strong>Salvar informa&ccedil;&otilde;es de depura&ccedil;&atilde;o para diagn&oacute;stico</strong></label>
        </div>
      </div>

      }
      <div class="settings-actions">
        <input type="submit" name="CHANGESETTINGS" value="Alterar configura&ccedil;&otilde;es" class="btn-primary">
      </div>

      </form>}
    </div>
  </div>
