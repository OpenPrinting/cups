          <div class="telemetry-badge">
            <span class="pulse-indicator"></span>
            <span>Motor IPP 2.0 / Everywhere Ativo</span>
          </div>
          <div class="telemetry-metrics">
            <span class="metric-item"><span class="metric-label">Escalonador:</span> <code class="metric-value">cupsd (pid auto)</code></span>
            <span class="metric-item"><span class="metric-label">Diretório de Spool:</span> <code class="metric-value">/var/spool/cups</code></span>
            <span class="metric-item"><span class="metric-label">Autenticação:</span> <code class="metric-value">Local / PeerCred</code></span>
            <span class="metric-item"><span class="metric-label">Paleta:</span> <code class="metric-value">Ctrl+K</code></span>
          </div>
        </div>
