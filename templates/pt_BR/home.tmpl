      <div class="row">
        <h2 class="title"><span class="prompt-marker">&gt;_</span> /server &mdash; Servidor e A&ccedil;&otilde;es R&aacute;pidas</h2>
        <div class="server-actions-bar">
	  <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="add-printer"><input type="submit" value="Adicionar impressora"></form>
	  <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="find-new-printers"><input type="submit" value="Encontrar novas impressoras"></form>
	  <form action="/printers/" method="GET"><input type="submit" value="Gerenciar impressoras"></form>
	  <form action="/jobs/" method="GET"><input type="submit" value="Gerenciar trabalhos"></form>
	  <form action="/admin/" method="GET"><input type="submit" value="Alterar configura&ccedil;&otilde;es"></form>
        </div>

        {#alert_title=0?:
        <div class="server-alerts-box" role="alert">
          <div class="alerts-title">&Delta; Alertas do Sistema:</div>
          <ul>{[alert_title]
            <li><a href="{alert_href}">{alert_title}</a></li>}
          </ul>
        </div>}

        <div class="cli-quickref">
          <div class="quickref-header">Comandos de Terminal para Diagnóstico Rápido:</div>
          <pre class="cli-block"><span class="cmd-prompt">$</span> lpstat -p -d <span class="cmd-comment"># Exibir status de todas as filas e verificar qual é o destino padrão</span></pre>
          <pre class="cli-block"><span class="cmd-prompt">$</span> lpstat -o <span class="cmd-comment"># Consultar trabalhos ativos no spooler local do CUPS</span></pre>
        </div>
      </div>

