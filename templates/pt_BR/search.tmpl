<div class="search-bar-container">
<form action="/{SECTION}/{?SEARCH_DEST}" method="GET" role="search" class="section-search-form">
{WHICH_JOBS?<input type="hidden" name="WHICH_JOBS" value="{WHICH_JOBS}">:}
{ORDER?<input type="hidden" name="ORDER" value="{ORDER}">:}

<div class="search-inputs-group">
  <label for="section-search-input" class="search-label">
    <span class="prompt-marker">&gt;_</span> Pesquisar em <strong>{SEARCH_DEST?{SEARCH_DEST}:{SECTION=classes?classes:{SECTION=jobs?trabalhos:impressoras}}}</strong>:
  </label>
  <input type="search" id="section-search-input" name="QUERY" value="{?QUERY}" size="36" placeholder="Filtrar por nome ou detalhes (/)..." autosave="org.cups.{SECTION}" results="20" aria-label="Pesquisar">
  <input type="submit" value="Pesquisar">
  <input type="submit" name="CLEAR" value="Limpar">
</div>

</form>
</div>
