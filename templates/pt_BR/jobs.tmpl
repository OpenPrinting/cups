{#job_id=0?
<div class="empty-state-box">
  <div class="empty-ascii">+----------------------------------------+<br>| &nbsp;[ _ ] &nbsp;Nenhum trabalho no spooler &nbsp;|<br>+----------------------------------------+</div>
  <p class="empty-text">Nenhum trabalho de impress&atilde;o ativo ou correspondente ao filtro selecionado.</p>
  <pre class="cli-block"><span class="cmd-prompt">$</span> lpstat -o <span class="cmd-comment"># Verificar a fila de trabalhos via terminal</span></pre>
</div>
:
<div class="table-container">
<table class="list" summary="Lista de Trabalhos de Impressão">
<thead>
<tr>
  <th scope="col">ID</th>
  <th scope="col">Nome do Arquivo</th>
  <th scope="col">Usu&aacute;rio</th>
  <th scope="col">Tamanho</th>
  <th scope="col">P&aacute;ginas</th>
  <th scope="col">Estado</th>
  <th scope="col">A&ccedil;&otilde;es de Controle</th>
</tr>
</thead>
<tbody>
{[job_id]
<tr valign="top">
  <td><a href="{job_printer_uri}" class="queue-name">{job_printer_name}</a>-<span class="job-id">{job_id}</span>{?phone? ({phone}):}&nbsp;</td>
  <td><strong>{?job_name=?Desconhecido:{job_name}}</strong>&nbsp;</td>
  <td><code>{?job_originating_user_name=?Retido:{job_originating_user_name}}</code>&nbsp;</td>
  <td class="mono-val">{job_k_octets}k&nbsp;</td>
  <td class="mono-val">{job_impressions_completed=0?&mdash;:{?job_impressions_completed}}&nbsp;</td>
  <td>
    {job_state=3?<span class="status-pill paused">&bull; Pendente</span><div class="card-meta">desde {?date_time_at_creation=?desconhecido:{date_time_at_creation}}</div>:
    {job_state=4?<span class="status-pill held">&FilledSmallSquare; Retido</span><div class="card-meta">desde {?date_time_at_creation=?desconhecido:{date_time_at_creation}}</div>:
    {job_state=5?<span class="status-pill processing">&bull; Processando</span><div class="card-meta">desde {?date_time_at_processing=?desconhecido:{date_time_at_processing}}</div>:
    {job_state=6?<span class="status-pill stopped">&times; Parado</span>:
    {job_state=7?<span class="status-pill stopped">&times; Cancelado</span><div class="card-meta">em {?date_time_at_completed=?desconhecido:{date_time_at_completed}}</div>:
    {job_state=8?<span class="status-pill stopped">&times; Abortado</span>:
    <span class="status-pill idle">&check; Conclu&iacute;do</span><div class="card-meta">em {?date_time_at_completed=?desconhecido:{date_time_at_completed}}</div>}}}}}}
    {job_printer_state_message?<div class="status-msg">"{job_printer_state_message}"</div>:}
  </td>
  <td>
    <div class="job-actions-group">
      {job_preserved>0?{job_state>5?
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="restart-job"><input type="hidden" name="job_id" value="{job_id}"><input type="hidden" name="job_printer_uri" value="{job_printer_uri}"><input type="submit" value="Reimprimir"></form>:}:}
      {job_state=4?
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="release-job"><input type="hidden" name="job_id" value="{job_id}"><input type="hidden" name="job_printer_uri" value="{job_printer_uri}"><input type="submit" value="Liberar"></form>:}
      {job_state=3?
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="hold-job"><input type="hidden" name="job_id" value="{job_id}"><input type="hidden" name="job_printer_uri" value="{job_printer_uri}"><input type="submit" value="Reter"></form>:}
      {job_state<7?
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="cancel-job"><input type="hidden" name="job_id" value="{job_id}"><input type="hidden" name="job_printer_uri" value="{job_printer_uri}"><input type="submit" value="Cancelar"></form>
      <form action="/jobs/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="move-job"><input type="hidden" name="job_id" value="{job_id}"><input type="submit" value="Mover"></form>:}
    </div>
  </td>
</tr>
}
</tbody>
</table>
</div>
}
