<!DOCTYPE HTML>
<html lang="pt-BR">
  <head>
    <link rel="stylesheet" href="/cups.css" type="text/css">
    <link rel="shortcut icon" href="/apple-touch-icon.png" type="image/png">
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    {refresh_page?<meta http-equiv="refresh" content="{refresh_page}">:}
    <meta http-equiv="X-UA-Compatible" content="IE=9">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>html{display:none;}</style>
    <noscript><style>html{display:block!important;}</style></noscript>
    <script type="text/javascript"><!--
      /* Only display document if we are not in a frame... */
      if (self == top) {
        document.documentElement.style.display = 'block';
      } else {
        top.location = self.location;
      }

      /* Show an error if cookies are disabled */
      function check_cookies() {
	if (!navigator.cookieEnabled) {
	      document.getElementById('body').innerHTML = 'Esta página utiliza cookies para prevenir ataques de falsificação cross-site. Por favor, habilite cookies no seu navegador.';
	}
      }
    --></SCRIPT>
    <script src="/cups.js" defer></script>
    <title>{title} - {ENV:CUPS_VERSION}</title>
  </head>
  <body onload="check_cookies();">
    <nav class="cups-header" role="navigation" aria-label="Navegação principal">
      <ul>
	<li><a class="img" href="https://openprinting.github.io/cups/" target="_blank" title="OpenPrinting CUPS"><img src="/images/cups.png" width="28" height="28" alt="OpenPrinting CUPS"><span class="prompt-glyph" aria-hidden="true">&gt;_</span></a></li>
	<li><a {SECTION=home?class="active" :}href="/" title="/home">In&iacute;cio</a></li>
	<li><a {SECTION=admin?class="active" :}href="/admin" title="/admin">Administração</a></li>
	<li><a {SECTION=classes?class="active" :}href="/classes/" title="/classes">Classes</a></li>
	<li><a {SECTION=help?class="active" :}href="/help/" title="/help">Ajuda</a></li>
	<li><a {SECTION=jobs?class="active" :}href="/jobs/" title="/jobs">Trabalhos</a></li>
	<li><a {SECTION=printers?class="active" :}href="/printers/" title="/printers">Impressoras</a></li>
	<li class="nav-cmd-item"><button type="button" class="btn-cmd-palette" id="btn-cmd-palette" title="Paleta de Comandos (Ctrl+K)" aria-label="Abrir Paleta de Comandos"><span class="cmd-icon">&gt;_</span> <span class="cmd-text">Paleta</span> <kbd class="kbd-badge">Ctrl+K</kbd></button></li>
	<li class="nav-mode-item"><button type="button" class="mode-toggle-btn" id="mode-toggle-btn" title="Alternar Modo Iniciante / Avançado" aria-label="Alternar modo de usuário"><span class="mode-indicator-dot" aria-hidden="true"></span><span class="mode-label-text">Modo: Iniciante</span></button></li>
	<li class="right"><form action="/" method="POST" role="search"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="search" name="QUERY" value="{?QUERY}" size="14" placeholder="Pesquisar (/)..." autosave="org.cups.site" results="20" aria-label="Pesquisar no servidor"><input type="submit" name="SEARCH" value="Pesquisar"></form></li>
	{?ENV:CUPS_OAUTH_SERVER=?:<li class="right"><form action="/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="submit" name="{?ENV:REMOTE_USER=?LOGIN:LOGOUT}" value="{?ENV:REMOTE_USER=?Entrar:Sair}"></form></li>}
	<li class="right"><span class="label">{?ENV:REMOTE_NAME=?Visitante:{ENV:REMOTE_NAME}}</span></li>
      </ul>
    </nav>
    <main class="cups-body" role="main">
      <div class="row">
