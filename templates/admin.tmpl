  <div class="halves">
    <div class="admin-panel">
      <h2 class="title"><span class="prompt-marker">&gt;_</span> /admin/printers &mdash; Print Queues</h2>
      <p class="admin-panel-desc">Direct management of physical devices and network endpoints.</p>
      <div class="server-actions-bar">
        <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="add-printer"><input type="submit" value="Add Printer"></form>
        <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="find-new-printers"><input type="submit" value="Find New Printers"></form>
        <form action="/printers/" method="GET"><input type="submit" value="Manage Printers"></form>
      </div>
    </div>

    <div class="admin-panel">
      <h2 class="title"><span class="prompt-marker">&gt;_</span> /admin/classes &mdash; Printer Classes</h2>
      <p class="admin-panel-desc">Pool multiple printers into a single logical queue with automatic failover.</p>
      <div class="server-actions-bar">
        <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="add-class"><input type="submit" value="Add Class"></form>
        <form action="/classes/" method="GET"><input type="submit" value="Manage Classes"></form>
      </div>
    </div>

    <div class="admin-panel">
      <h2 class="title"><span class="prompt-marker">&gt;_</span> /admin/jobs &mdash; Spooler &amp; Job Management</h2>
      <p class="admin-panel-desc">Auditing, batch cancellation, hold, and release of print jobs.</p>
      <div class="server-actions-bar">
        <form action="/jobs/" method="GET"><input type="submit" value="Manage Jobs"></form>
      </div>
    </div>
  </div>

  <div class="halves">
    <div class="admin-panel">
      <h2 class="title"><span class="prompt-marker">&gt;_</span> /admin/server &mdash; CUPS Daemon Settings</h2>

      <div class="server-actions-bar">
        <form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="config-server"><input type="submit" value="Edit cupsd.conf Configuration File"></form>
      </div>

      {SETTINGS_ERROR?<div class="server-alerts-box" role="alert"><p><strong>{SETTINGS_MESSAGE}</strong></p><blockquote>{SETTINGS_ERROR}</blockquote></div>:

      <form method="POST" action="/admin">
      <input type="hidden" name="org.cups.sid" value="{$org.cups.sid}">

      {ADVANCEDSETTINGS?
      <div class="settings-group">
        <div class="settings-header">
          <strong>Advanced cupsd Settings</strong> &bull; <a href="/admin/" class="disclosure-link">Hide Advanced <small>&#x25bc;</small></a>
        </div>

        <input type="hidden" name="OP" value="config-server">
        <input type="hidden" name="ADVANCEDSETTINGS" value="CHECKED">

        <div class="setting-item">
          <label><input type="checkbox" name="SHARE_PRINTERS" id="SHARE_PRINTERS" value="CHECKED" {?share_printers}> <strong>Share printers connected to this system</strong></label>
          <div class="setting-desc">Advertises queues via mDNS/DNS-SD (Bonjour/Avahi) on local subnet.</div>
        </div>

        <div class="setting-item setting-indent">
          <label>Max simultaneous clients&#58; <input type="text" name="MAX_CLIENTS" value="{?max_clients}" size="6" class="mono-val"></label>
          <div class="setting-desc">Limits open client sockets to prevent file descriptor exhaustion.</div>
        </div>

        <div class="setting-item setting-indent">
          <label><input type="checkbox" name="REMOTE_ANY" id="REMOTE_ANY" value="CHECKED" {?remote_any}> <strong>Allow printing from the Internet</strong></label>
          <div class="setting-desc">Permits incoming requests beyond the local subnet (0.0.0.0/0).</div>
        </div>

        <div class="setting-item setting-indent">
          <label><input type="checkbox" name="BROWSE_WEB_IF" id="BROWSE_WEB_IF" value="CHECKED" {?browse_web_if}> <strong>Advertise web interface</strong></label>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="REMOTE_ADMIN" id="REMOTE_ADMIN" value="CHECKED" {?remote_admin}> <strong>Allow remote administration</strong></label>
          <div class="setting-desc">Allows browser-based administrative access from other IP addresses.</div>
        </div>

        {have_gssapi?<div class="setting-item"><label><input type="checkbox" name="KERBEROS" id="KERBEROS" value="CHECKED" {?kerberos}> <strong>Use Kerberos authentication</strong> (<a href="/help/kerberos.html?TOPIC=Getting+Started">Documentation</a>)</label></div>:}

        <div class="setting-item">
          <label><input type="checkbox" name="USER_CANCEL_ANY" id="USER_CANCEL_ANY" value="CHECKED" {?user_cancel_any}> <strong>Allow users to cancel any job (not just their own)</strong></label>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="PRESERVE_JOBS" id="PRESERVE_JOBS" value="CHECKED" {?preserve_jobs}> <strong>Preserve job history</strong></label>
        </div>

        <div class="setting-item setting-indent">
          <label>Maximum jobs (0 for no limit)&#58; <input type="text" name="MAX_JOBS" value="{?max_jobs}" size="6" class="mono-val"></label>
        </div>

        <div class="setting-item setting-indent">
          <label>Retain Metadata&#58; <input type="text" name="PRESERVE_JOB_HISTORY" value="{?preserve_job_history}" size="6" class="mono-val"></label>
        </div>

        <div class="setting-item setting-indent">
          <label>Retain Documents&#58; <input type="text" name="PRESERVE_JOB_FILES" value="{?preserve_job_files}" size="6" class="mono-val"></label>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="DEBUG_LOGGING" id="DEBUG_LOGGING" value="CHECKED" {?debug_logging}> <strong>Save debugging information (LogLevel debug)</strong></label>
          <div class="setting-desc">Essential for root-cause diagnosis of driver and filter issues.</div>
        </div>

        <div class="setting-item setting-indent">
          <label>Max log file size&#58; <input type="text" name="MAX_LOG_SIZE" value="{?max_log_size}" size="6" class="mono-val"></label>
        </div>
      </div>

      :
      <div class="settings-group">
        <div class="settings-header">
          <strong>Basic Server Settings</strong> &bull; <a href="/admin/?ADVANCEDSETTINGS=YES" class="disclosure-link">Show Advanced <small>&#x25b6;</small></a>
        </div>

        <input type="hidden" name="OP" value="config-server">

        <div class="setting-item">
          <label><input type="checkbox" name="SHARE_PRINTERS" id="SHARE_PRINTERS" value="CHECKED" {?share_printers}> <strong>Share printers connected to this system</strong></label>
        </div>

        <div class="setting-item setting-indent">
          <label><input type="checkbox" name="REMOTE_ANY" id="REMOTE_ANY" value="CHECKED" {?remote_any}> <strong>Allow printing from the Internet</strong></label>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="REMOTE_ADMIN" id="REMOTE_ADMIN" value="CHECKED" {?remote_admin}> <strong>Allow remote administration</strong></label>
        </div>

        {have_gssapi?<div class="setting-item"><label><input type="checkbox" name="KERBEROS" id="KERBEROS" value="CHECKED" {?kerberos}> <strong>Use Kerberos authentication</strong> (<a href="/help/kerberos.html?TOPIC=Getting+Started">Documentation</a>)</label></div>:}

        <div class="setting-item">
          <label><input type="checkbox" name="USER_CANCEL_ANY" id="USER_CANCEL_ANY" value="CHECKED" {?user_cancel_any}> <strong>Allow users to cancel any job</strong></label>
        </div>

        <div class="setting-item">
          <label><input type="checkbox" name="DEBUG_LOGGING" id="DEBUG_LOGGING" value="CHECKED" {?debug_logging}> <strong>Save debugging information for troubleshooting</strong></label>
        </div>
      </div>

      }
      <div class="settings-actions">
        <input type="submit" name="CHANGESETTINGS" value="Change Settings" class="btn-primary">
      </div>

      </form>}
    </div>
  </div>
