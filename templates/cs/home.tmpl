	<h1>{ENV:CUPS_VERSION}</h1>
	<p>Standardizovaný tiskový systém s otevřeným kódem vyvíjený <a class="jumbolink" href="https://openprinting.github.io/" target="_blank">OpenPrinting</a> pro Linux® a ostatní Unix®-ové operační systémy. CUPS používá pro podporu lokálního a síťového tisku <a href="https://www.pwg.org/ipp/everywhere.html" target="_blank">IPP Everywhere™</a>.</p>
      </div>
      <div class="row">
        <h2 class="title">Tento systém</h2>
	<form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="add-printer"><input type="submit" value="Přidat tiskárnu"></form>
	<form action="/admin/" method="POST"><input type="hidden" name="org.cups.sid" value="{$org.cups.sid}"><input type="hidden" name="OP" value="find-new-printers"><input type="submit" value="Vyhledat tiskárny"></form>
	<form action="/jobs/" method="GET"><input type="submit" value="Spravovat úlohy"></form>
	<form action="/printers/" method="GET"><input type="submit" value="Spravovat tiskárny"></form>
	<form action="/admin/" method="GET"><input type="submit" value="Spravovat nastavení systému"></form>
        {#alert_title=0?:<p>Upozornění:</p>
        <ul>{[alert_title]
          <li><a href="{alert_href}">{alert_title}</a></li>}
        </ul>}
