msgstr ""
"-o print-quality=X        Nastaví kvalitu tisku\n"
"                          - koncept (3), normální (4), nebo nejlepší (5)"

msgid ""
"-o printer-error-policy=name\n"
"                        Specify the printer error policy"
msgstr ""
"-o printer-error-policy=název_zásad\n"
"                          Nastaví zásady pro chyby tiskárny"

msgid ""
"-o printer-is-shared=true\n"
"                        Share the printer"
msgstr ""
"-o printer-is-shared=true\n"
"                          Povolí sdílení tiskárny"

msgid ""
"-o printer-op-policy=name\n"
"                        Specify the printer operation policy"
msgstr ""
"-o printer-op-policy=název_zásad\n"
"                          Nastaví zásady provozu tiskárny"

msgid "-o sides=one-sided      Specify 1-sided printing"
msgstr "-o sides=one-sided        Nastaví jednostranný tisk"

msgid ""
"-o sides=two-sided-long-edge\n"
"                        Specify 2-sided portrait printing"
msgstr ""
"-o sides=two-sided-long-edge\n"
"                          Nastaví oboustranný tisk na výšku"

msgid ""
"-o sides=two-sided-short-edge\n"
"                        Specify 2-sided landscape printing"
msgstr ""
"-o sides=two-sided-short-edge\n"
"                          Nastaví oboustranný tisk na šířku"

