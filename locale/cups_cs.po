msgstr "-o volba[=hodnota]        Nastaví volby tiskárny"

msgid ""
"-o orientation-requested=N\n"
"                        Specify portrait (3) or landscape (4) orientation"
msgstr ""
"-o orientation-requested=X\n"
"                          Nastaví orientaci na výšku (3), nebo na šířku (4)"

