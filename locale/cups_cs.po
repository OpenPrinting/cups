msgid "-v                      Be verbose"
msgstr "-v                        Použije podrobný výstup"

msgid "-v                      Show devices"
msgstr "-v                        Zobrazí zařízení"

msgid "-v [printer(s)]         Show the devices for each destination"
msgstr "-v [tiskárna(y)]          Zobrazí tiskárny a k nim náležející zařízení"

