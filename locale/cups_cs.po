"                          dataEncipherment, keyAgreement, keyCertSign, "
"cRLSign,\n"
"                          encipherOnly, decipherOnly, default-ca, default-"
"tls)"

msgid ""
"-u [user(s)]            Show jobs queued by the current or specified users"
msgstr ""
"-u [uživatel(é)]          Zobrazí úlohy aktuálního uživatele, nebo zadaných\n"
