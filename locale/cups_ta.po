msgstr "-ஒரு அங்கீகாரத்தை இயக்கு"

msgid "-C                      Send requests using chunking (default)"
msgstr "-C chunking ஐப் பயன்படுத்தி கோரிக்கைகளை அனுப்பவும் (இயல்புநிலை)"

msgid "-C COUNTRY                     Set country."
msgstr "-C நாடு செட் நாடு."

msgid "-D description          Specify the textual description of the printer"
msgstr "-D விளக்கம் அச்சுப்பொறியின் உரை விளக்கத்தைக் குறிப்பிடவும்"

msgid "-D device-uri           Set the device URI for the printer"
msgstr "-D device-uri பிரிண்டருக்கான சாதன யூரி ஐ அமைக்கவும்"

msgid ""
"-E                      Enable and accept jobs on the printer (after -p)"
msgstr "-E அச்சுப்பொறியில் வேலைகளை இயக்கி ஏற்கவும் (பின் -p)"

msgid "-E                      Encrypt the connection to the server"
msgstr "-இ சேவையகத்திற்கான இணைப்பை குறியாக்கு"

msgid "-E                      Test with encryption using HTTP Upgrade to TLS"
msgstr "-E TLSக்கு HTTP மேம்படுத்தலைப் பயன்படுத்தி குறியாக்கத்துடன் சோதனை"

msgid "-F                      Run in the foreground but detach from console."
msgstr "-F முன்புறத்தில் இயக்கவும் ஆனால் கன்சோலில் இருந்து பிரிக்கவும்."

msgid "-F output-type/subtype  Set the output format for the printer"
msgstr "-F வெளியீடு-வகை/துணை வகை பிரிண்டருக்கான வெளியீட்டு வடிவமைப்பை அமைக்கவும்"

msgid "-H                      Show the default server and port"
msgstr "-எச் இயல்புநிலை சர்வர் மற்றும் போர்ட்டைக் காட்டு"

msgid "-H HH:MM                Hold the job until the specified UTC time"
msgstr "-H HH:MM குறிப்பிட்ட UTC நேரம் வரை வேலையைப் பிடித்துக் கொள்ளுங்கள்"

msgid "-H hold                 Hold the job until released/resumed"
msgstr "-எச் வேலையை விடுவிக்கும் வரை/மீண்டும் தொடங்கும் வரை வைத்திருக்கவும்"

msgid "-H immediate            Print the job as soon as possible"
msgstr "-எச் உடனடியாக வேலையை சீக்கிரம் அச்சிடுங்கள்"

msgid "-H restart              Reprint the job"
msgstr "-எச் மறுதொடக்கம் வேலையை மீண்டும் அச்சிடுக"

msgid "-H resume               Resume a held job"
msgstr "-எச்"

msgid "-H server[:port]        Connect to the named server and port"
msgstr "-எச் சர்வர்[:போர்ட்] பெயரிடப்பட்ட சர்வர் மற்றும் போர்ட்டுடன் இணைக்கவும்"

msgid "-I                      Ignore errors"
msgstr "- நான் பிழைகளைப் புறக்கணிக்கிறேன்"

msgid ""
"-I {filename,filters,none,profiles}\n"
"                          Ignore specific warnings"
msgstr ""
"-நான் {கோப்பு பெயர், வடிகட்டிகள், எதுவுமில்லை, சுயவிவரங்கள்} \n"
"குறிப்பிட்ட எச்சரிக்கைகளை புறக்கணிக்கவும்"

msgid ""
"-K keypath              Set location of server X.509 certificates and keys."
msgstr "-K விசைப்பாதை X.509 சான்றிதழ்கள் மற்றும் விசைகளின் சர்வர் இருப்பிடத்தை அமைக்கவும்."

msgid "-L                      Send requests using content-length"
msgstr "-எல் உள்ளடக்க நீளத்தைப் பயன்படுத்தி கோரிக்கைகளை அனுப்பவும்"

msgid "-L LOCALITY                    Set locality name."
msgstr "-L LOCALITY வட்டாரப் பெயரை அமை."

msgid "-L location             Specify the textual location of the printer"
msgstr "-L இடம் அச்சுப்பொறியின் உரை இருப்பிடத்தைக் குறிப்பிடவும்"

msgid "-M manufacturer         Set manufacturer name (default=Test)"
msgstr "-எம் உற்பத்தியாளர் செட் உற்பத்தியாளர் பெயர் (இயல்பு=சோதனை)"

msgid "-N name                 Match service name to literal name value"
msgstr "-N பெயர் சேவையின் பெயரை நேரடி பெயர் மதிப்புக்கு பொருத்தவும்"

msgid "-O ORGANIZATION                Set organization name."
msgstr "-O அமைப்பு அமைப்பு பெயரை அமைக்கவும்."

msgid "-P destination          Show status for the specified destination"
msgstr "-P இலக்கு குறிப்பிட்ட இலக்குக்கான நிலையைக் காட்டு"

msgid "-P destination          Specify the destination"
msgstr "-P இலக்கு இலக்கைக் குறிப்பிடவும்"

msgid ""
"-P filename.plist       Produce XML plist to a file and test report to "
"standard output"
msgstr ""
"-P filename.plist ஒரு கோப்பில் நீகுமொ plist ஐ உருவாக்கவும் மற்றும் நிலையான "
"வெளியீட்டிற்கு சோதனை அறிக்கையை உருவாக்கவும்"

msgid "-P filename.ppd         Load printer attributes from PPD file"
msgstr "-P filename.ppd PPD கோப்பிலிருந்து பிரிண்டர் பண்புகளை ஏற்றவும்"

msgid "-P number[-number]      Match port to number or range"
msgstr "-P எண்[-எண்] எண் அல்லது வரம்புடன் துறைமுகம் பொருத்தவும்"

msgid "-P page-list            Specify a list of pages to print"
msgstr "-P பக்கப் பட்டியல் அச்சிட வேண்டிய பக்கங்களின் பட்டியலைக் குறிப்பிடவும்"

msgid "-R                      Repeat tests on server-error-busy"
msgstr "-R சர்வர்-பிழை-பிசியில் சோதனைகளை மீண்டும் செய்யவும்"

msgid "-R                      Show the ranking of jobs"
msgstr "-R வேலைகளின் தரவரிசையைக் காட்டு"

msgid ""
"-R CSR-FILENAME                Specify certificate signing request file."
msgstr "-R CSR-FILENAME சான்றிதழ் கையொப்பமிடும் கோரிக்கை கோப்பைக் குறிப்பிடவும்."

msgid "-R name-default         Remove the default value for the named option"
msgstr "-R பெயர்-இயல்புநிலை பெயரிடப்பட்ட விருப்பத்திற்கான இயல்புநிலை மதிப்பை அகற்றவும்"

msgid "-R root-directory       Set alternate root"
msgstr "-R ரூட்-டைரக்டரி மாற்று ரூட்டை அமைக்கவும்"

msgid "-S                      Test with encryption using HTTPS"
msgstr "HTTPS ஐப் பயன்படுத்தி குறியாக்கத்துடன் -S சோதனை"

msgid "-S STATE                       Set state."
msgstr "-எச் ச்டேட் மாநிலத்தை அமைக்கவும்."

msgid "-S filename.strings     Set strings file"
msgstr "-S filename.strings சரங்கள் கோப்பை அமைக்கவும்"

msgid "-T seconds              Set the browse timeout in seconds"
msgstr "-டி வினாடிகள் உலாவல் நேரத்தை வினாடிகளில் அமைக்கவும்"

msgid "-T seconds              Set the receive/send timeout in seconds"
msgstr "-டி வினாடிகள் பெறுதல்/அனுப்பு நேரம் முடிவதை வினாடிகளில் அமைக்கவும்"

msgid "-T title                Specify the job title"
msgstr "-டி தலைப்பு வேலை தலைப்பைக் குறிப்பிடவும்"

msgid "-U ORGANIZATIONAL-UNIT         Set organizational unit name."
msgstr "-U நிறுவன-அலகு அமைப்பு அலகு பெயரை அமைக்கவும்."

msgid "-U username             Specify the username to use for authentication"
msgstr "-U பயனர்பெயர் அங்கீகாரத்திற்கு பயன்படுத்த பயனர்பெயரை குறிப்பிடவும்"

msgid "-U username             Specify username to use for authentication"
msgstr "-U பயனர்பெயர் அங்கீகாரத்திற்கு பயன்படுத்த பயனர்பெயரை குறிப்பிடவும்"

msgid "-V version              Set default IPP version"
msgstr "-V பதிப்பு இயல்புநிலை IPP பதிப்பை அமைக்கவும்"

msgid "-W completed            Show completed jobs"
msgstr "-W நிறைவு செய்த வேலைகளை காட்டு"

msgid "-W not-completed        Show pending jobs"
msgstr "-W முடிக்கப்படவில்லை நிலுவையில் உள்ள வேலைகளைக் காட்டு"

msgid ""
"-W {all,none,constraints,defaults,duplex,filters,profiles,sizes,"
"translations}\n"
"                          Issue warnings instead of errors"
msgstr ""
"-W {அனைத்தும், எதுவுமில்லை, கட்டுப்பாடுகள், இயல்புநிலைகள், இரட்டை, வடிகட்டிகள், "
"சுயவிவரங்கள், அளவுகள், மொழிபெயர்ப்புகள்} \n"
"பிழைகளுக்குப் பதிலாக எச்சரிக்கைகளை வெளியிடவும்"

msgid "-X                      Produce XML plist instead of plain text"
msgstr "-X எளிய உரைக்குப் பதிலாக நீகுமொ plist ஐ உருவாக்கவும்"

msgid "-a                      Cancel all jobs"
msgstr "அனைத்து வேலைகளையும் ரத்து வெற்றி"

msgid "-a                      Show jobs on all destinations"
msgstr "-a எல்லா இடங்களிலும் வேலைகளைக் காட்டு"

msgid ""
"-a OAUTH-URI                   Specify the OAuth authorization server URL"
msgstr "-a OAUTH-URI OAuth அங்கீகார சேவையக முகவரி ஐக் குறிப்பிடவும்"

msgid "-a SUBJECT-ALT-NAME            Add a subjectAltName."
msgstr "-ஒரு SUBJECT-ALT-NAME ஒரு subjectAltName ஐச் சேர்க்கவும்."

msgid "-a [destination(s)]     Show the accepting state of destinations"
msgstr "-a [இலக்கு(கள்)] சேருமிடங்களின் ஏற்றுக்கொள்ளும் நிலையைக் காட்டு"

msgid "-a filename.conf        Load printer attributes from conf file"
msgstr "-a filename.conf conf கோப்பிலிருந்து பிரிண்டர் பண்புகளை ஏற்றவும்"

msgid "-c                      Make a copy of the print file(s)"
msgstr "-c அச்சு கோப்பின் (கள்) நகலை உருவாக்கவும்"

msgid "-c                      Produce CSV output"
msgstr "-c காபிம வெளியீட்டை உருவாக்கவும்"

msgid "-c [class(es)]          Show classes and their member printers"
msgstr "-c [வகுப்பு(கள்)] வகுப்புகள் மற்றும் அவற்றின் உறுப்பினர் பிரிண்டர்களைக் காட்டு"

msgid "-c class                Add the named destination to a class"
msgstr "-c வகுப்பு ஒரு வகுப்பில் பெயரிடப்பட்ட இலக்கைச் சேர்க்கவும்"

msgid "-c command              Set print command"
msgstr "-c கட்டளை அச்சு கட்டளையை அமைக்கவும்"

msgid "-c cupsd.conf           Set cupsd.conf file to use."
msgstr "-c cupsd.conf, cupsd.conf கோப்பைப் பயன்படுத்த அமைக்கவும்."

msgid "-d                      Show the default destination"
msgstr "-d இயல்புநிலை இலக்கைக் காட்டு"

msgid "-d DAYS                        Set expiration date in days."
msgstr "-d நாட்கள் காலாவதி தேதியை நாட்களில் அமைக்கவும்."

msgid "-d destination          Set default destination"
msgstr "-d இலக்கு இயல்புநிலை இலக்கை அமைக்கவும்"

msgid "-d destination          Set the named destination as the server default"
msgstr "-d இலக்கு பெயரிடப்பட்ட இலக்கை சேவையக இயல்புநிலையாக அமைக்கவும்"

msgid "-d destination          Specify the destination"
msgstr "-d இலக்கு இலக்கைக் குறிப்பிடவும்"

msgid "-d name=value           Set named variable to value"
msgstr "-d பெயர்=மதிப்பு மதிப்புக்கு மாறி பெயரிடப்பட்டது"

msgid "-d regex                Match domain to regular expression"
msgstr "-d வழக்கவெளி டொமைனை வழக்கமான வெளிப்பாட்டுடன் பொருத்தவும்"

msgid "-d spool-directory      Set spool directory"
msgstr "-d spool-directory ச்பூல் கோப்பகத்தை அமைக்கவும்"

msgid "-e                      Show available destinations on the network"
msgstr "-e நெட்வொர்க்கில் கிடைக்கும் இடங்களைக் காட்டு"

msgid "-f                      Run in the foreground."
msgstr "-f முன்புறத்தில் இயக்கவும்."

msgid "-f filename             Set default request filename"
msgstr "-f கோப்பு பெயர் இயல்புநிலை கோரிக்கை கோப்பு பெயரை அமைக்கவும்"

msgid "-f type/subtype[,...]   Set supported file types"
msgstr "-f வகை/துணை வகை[,...] ஆதரிக்கப்படும் கோப்பு வகைகளை அமைக்கவும்"

msgid "-h                      Show this usage message."
msgstr "-h இந்த பயன்பாட்டுச் செய்தியைக் காட்டு."

msgid "-h                      Validate HTTP response headers"
msgstr "-h HTTP மறுமொழி தலைப்புகளை சரிபார்க்கவும்"

msgid "-h regex                Match hostname to regular expression"
msgstr "-h வழக்கவெளி ஓச்ட்பெயரை வழக்கமான வெளிப்பாட்டுடன் பொருத்தவும்"

msgid "-h server[:port]        Connect to the named server and port"
msgstr "-h சர்வர்[:போர்ட்] பெயரிடப்பட்ட சர்வர் மற்றும் போர்ட்டுடன் இணைக்கவும்"

msgid "-i iconfile.png[,...]   Set icon file(s)"
msgstr "-i iconfile.png[,...] படவுரு கோப்பு(களை) அமைக்கவும்"

msgid "-i id                   Specify an existing job ID to modify"
msgstr "-i அடையாளம் மாற்றுவதற்கு ஏற்கனவே உள்ள வேலை ஐடியைக் குறிப்பிடவும்"

msgid "-i ppd-file             Specify a PPD file for the printer"
msgstr "-i ppd-file அச்சுப்பொறிக்கான PPD கோப்பைக் குறிப்பிடவும்"

msgid ""
"-i seconds              Repeat the last file with the given time interval"
msgstr "-i வினாடிகள் கொடுக்கப்பட்ட நேர இடைவெளியுடன் கடைசி கோப்பை மீண்டும் செய்யவும்"

msgid "-k                      Keep job spool files"
msgstr "-k                      Keep பணி spool கோப்புகள்"

msgid "-l                      List attributes"
msgstr "-எல் பண்புகளை பட்டியல்"

msgid "-l                      Produce plain text output"
msgstr "-எல் எளிய உரை வெளியீட்டை உருவாக்கவும்"

msgid "-l                      Run cupsd on demand."
msgstr "தேவைக்கேற்ப கப்எச்டியை இயக்கவும்."

msgid "-l                      Show supported options and values"
msgstr "-l ஆதரிக்கப்படும் விருப்பங்கள் மற்றும் மதிப்புகளைக் காட்டு"

msgid "-l                      Show verbose (long) output"
msgstr "-எல் வாய்மொழி (நீண்ட) வெளியீட்டைக் காட்டு"

msgid "-l location             Set location of printer"
msgstr "-l இடம் பிரிண்டரின் இருப்பிடத்தை அமைக்கவும்"

msgid ""
"-m                      Send an email notification when the job completes"
msgstr "-m வேலை முடிந்ததும் மின்னஞ்சல் அறிவிப்பை அனுப்பவும்"

msgid "-m                      Show models"
msgstr "-m மாதிரிகளைக் காட்டு"

msgid ""
"-m everywhere           Specify the printer is compatible with IPP Everywhere"
msgstr ""
"-m எல்லா இடங்களிலும் அச்சுப்பொறி எல்லா இடங்களிலும் IPP உடன் இணக்கமாக இருப்பதைக் "
"குறிப்பிடவும்"

msgid "-m model                Set model name (default=Printer)"
msgstr "-m மாதிரி மாதிரி பெயரை அமை (இயல்பு=அச்சுப்பொறி)"

msgid ""
"-m model                Specify a standard model/PPD file for the printer"
msgstr "-m மாதிரி அச்சுப்பொறிக்கான நிலையான மாதிரி/PPD கோப்பைக் குறிப்பிடவும்"

msgid "-n count                Repeat the last file the given number of times"
msgstr "-n எண்ணிக்கை கொடுக்கப்பட்ட எண்ணிக்கையில் கடைசி கோப்பை மீண்டும் செய்யவும்"

msgid "-n hostname             Set hostname for printer"
msgstr "-n ஓச்ட்பெயர் அச்சுப்பொறிக்கான ஓச்ட்பெயரை அமைக்கவும்"

msgid "-n num-copies           Specify the number of copies to print"
msgstr "-n எண்-நகல்கள் அச்சிட வேண்டிய பிரதிகளின் எண்ணிக்கையைக் குறிப்பிடவும்"

msgid "-n regex                Match service name to regular expression"
msgstr "-n வழக்கவெளி சேவையின் பெயரை வழக்கமான வெளிப்பாட்டுடன் பொருத்தவும்"

msgid ""
"-o Name=Value           Specify the default value for the named PPD option "
msgstr ""
"-o பெயர்=மதிப்பு பெயரிடப்பட்ட PPD விருப்பத்திற்கான இயல்புநிலை மதிப்பைக் குறிப்பிடவும் "

msgid "-o [destination(s)]     Show jobs"
msgstr "-o [இலக்கு(கள்)] வேலைகளைக் காட்டு"

msgid ""
"-o cupsIPPSupplies=false\n"
"                        Disable supply level reporting via IPP"
msgstr ""
"-o cupsIPPSupplies=false \n"
"IPP மூலம் விநியோக நிலை அறிக்கையை முடக்கு"

msgid ""
"-o cupsSNMPSupplies=false\n"
"                        Disable supply level reporting via SNMP"
msgstr ""
"-o கோப்பைகள்SNMPSசப்ளைச்=பொய் \n"
"SNMP வழியாக விநியோக நிலை அறிக்கையை முடக்கு"

msgid "-o job-k-limit=N        Specify the kilobyte limit for per-user quotas"
msgstr ""
"-o job-k-limit=N ஒவ்வொரு பயனருக்கான ஒதுக்கீட்டுக்கான கிலோபைட் வரம்பை குறிப்பிடவும்"

msgid "-o job-page-limit=N     Specify the page limit for per-user quotas"
msgstr "-o job-page-limit=N ஒரு பயனர் ஒதுக்கீட்டிற்கான பக்க வரம்பை குறிப்பிடவும்"

msgid "-o job-quota-period=N   Specify the per-user quota period in seconds"
msgstr ""
"-o job-quota-period=N ஒவ்வொரு பயனருக்கும் ஒதுக்கீட்டு காலத்தை நொடிகளில் குறிப்பிடவும்"

msgid "-o job-sheets=standard  Print a banner page with the job"
msgstr "-o job-sheets=standard வேலையுடன் பேனர் பக்கத்தை அச்சிடவும்"

msgid "-o media=size           Specify the media size to use"
msgstr "-o media=size பயன்படுத்த வேண்டிய ஊடக அளவைக் குறிப்பிடவும்"

msgid "-o name-default=value   Specify the default value for the named option"
msgstr ""
"-o name-default=value பெயரிடப்பட்ட விருப்பத்திற்கான இயல்புநிலை மதிப்பைக் குறிப்பிடவும்"

msgid "-o name[=value]         Set default option and value"
msgstr "-o பெயர்[=மதிப்பு] இயல்புநிலை விருப்பத்தையும் மதிப்பையும் அமைக்கவும்"

msgid ""
"-o number-up=N          Specify that input pages should be printed N-up (1, "
"2, 4, 6, 9, and 16 are supported)"
msgstr ""
"-o number-up=N உள்ளீட்டுப் பக்கங்கள் N-up அச்சிடப்பட வேண்டும் என்பதைக் குறிப்பிடவும் (1, 2, "
"4, 6, 9, மற்றும் 16 ஆதரிக்கப்படுகின்றன)"

msgid "-o option[=value]       Specify a printer-specific option"
msgstr "-o விருப்பம்[=மதிப்பு] பிரிண்டர்-குறிப்பிட்ட விருப்பத்தைக் குறிப்பிடவும்"

msgid ""
"-o orientation-requested=N\n"
"                        Specify portrait (3) or landscape (4) orientation"
msgstr ""
"-o orientation-requested=N \n"
"உருவப்படம் (3) அல்லது நிலப்பரப்பு (4) நோக்குநிலையைக் குறிப்பிடவும்"

msgid ""
"-o print-quality=N      Specify the print quality - draft (3), normal (4), "
"or best (5)"
msgstr ""
"-o print-quality=N அச்சுத் தரத்தைக் குறிப்பிடவும் - வரைவு (3), இயல்பான (4) அல்லது "
"சிறந்தது (5)"

msgid ""
"-o printer-error-policy=name\n"
"                        Specify the printer error policy"
msgstr ""
"-o printer-error-policy=பெயர் \n"
"பிரிண்டர் பிழை கொள்கையை குறிப்பிடவும்"

msgid ""
"-o printer-is-shared=true\n"
"                        Share the printer"
msgstr ""
"-o printer-is-shared=true \n"
"பிரிண்டரைப் பகிரவும்"

msgid ""
"-o printer-op-policy=name\n"
"                        Specify the printer operation policy"
msgstr ""
"-o printer-op-policy=பெயர் \n"
"பிரிண்டர் செயல்பாட்டுக் கொள்கையைக் குறிப்பிடவும்"

msgid "-o sides=one-sided      Specify 1-sided printing"
msgstr "-o பக்கங்கள்=ஒரு பக்க 1-பக்க அச்சிடலைக் குறிப்பிடவும்"

msgid ""
"-o sides=two-sided-long-edge\n"
"                        Specify 2-sided portrait printing"
msgstr ""
"-o பக்கங்கள்=இரண்டு பக்க நீண்ட விளிம்பு \n"
"2 பக்க போர்ட்ரெய்ட் பிரிண்டிங்கைக் குறிப்பிடவும்"

msgid ""
"-o sides=two-sided-short-edge\n"
"                        Specify 2-sided landscape printing"
msgstr ""
"-o பக்கங்கள்=இரண்டு பக்க-குறுகிய விளிம்பு \n"
"2-பக்க இயற்கை அச்சிடலைக் குறிப்பிடவும்"

msgid "-p                      Print URI if true"
msgstr "-p உண்மை என்றால் யூரி ஐ அச்சிடவும்"

msgid ""
"-p PURPOSE                     Comma-delimited certificate purpose\n"
"                               (serverAuth, clientAuth, codeSigning, "
"emailProtection, timeStamping, OCSPSigning)"
msgstr ""
"-p நோக்கம் கமாவால் பிரிக்கப்பட்ட சான்றிதழ் நோக்கம் \n"
"(serverAuth, clientAuth, codeSigning, emailProtection, timestamping, OCSPS "
"signing)"

msgid "-p [printer(s)]         Show the processing state of destinations"
msgstr "-p [அச்சுப்பொறி(கள்)] இலக்குகளின் செயலாக்க நிலையைக் காட்டு"

msgid "-p destination          Specify a destination"
msgstr "-p இலக்கு ஒரு இலக்கைக் குறிப்பிடவும்"

msgid "-p destination          Specify/add the named destination"
msgstr "-p இலக்கு பெயரிடப்பட்ட இலக்கைக் குறிப்பிடவும்/சேர்க்கவும்"

msgid "-p port                 Set port number for printer"
msgstr "-p துறைமுகம் பிரிண்டருக்கான துறைமுகம் எண்ணை அமைக்கவும்"

msgid "-q                      Quietly report match via exit code"
msgstr "-q வெளியேறும் குறியீடு மூலம் அமைதியாகப் பொருத்தத்தைப் புகாரளிக்கவும்"

msgid "-q                      Run silently"
msgstr "-கே அமைதியாக ஓடு"

msgid "-q                      Specify the job should be held for printing"
msgstr "-q அச்சிடுவதற்கான வேலையைக் குறிப்பிடவும்"

msgid "-q priority             Specify the priority from low (1) to high (100)"
msgstr "-q முன்னுரிமை குறைந்த (1) முதல் அதிக (100) வரை முன்னுரிமையைக் குறிப்பிடவும்"

msgid "-r                      Remove the file(s) after submission"
msgstr "-r சமர்ப்பித்த பிறகு கோப்பை (களை) அகற்றவும்"

msgid "-r                      Show whether the CUPS server is running"
msgstr "-r CUPS சர்வர் இயங்குகிறதா என்பதைக் காட்டவும்"

msgid "-r                      True if service is remote"
msgstr "-r பணி தொலைவில் இருந்தால் உண்மை"

msgid "-r                      Use 'relaxed' open mode"
msgstr "-r 'ரிலாக்ச்டு' திறந்த பயன்முறையைப் பயன்படுத்தவும்"

msgid "-r ROOT-NAME                   Name of root certificate"
msgstr "-r ROOT-NAME ரூட் சான்றிதழின் பெயர்"

msgid "-r class                Remove the named destination from a class"
msgstr "-r வகுப்பு ஒரு வகுப்பிலிருந்து பெயரிடப்பட்ட இலக்கை அகற்றவும்"

msgid "-r reason               Specify a reason message that others can see"
msgstr "-r காரணம் மற்றவர்கள் பார்க்கக்கூடிய ஒரு காரணச் செய்தியைக் குறிப்பிடவும்"

msgid "-r subtype,[subtype]    Set DNS-SD service subtype"
msgstr "-r துணை வகை,[துணை வகை] DNS-SD பணி துணை வகையை அமைக்கவும்"

msgid "-s                      Be silent"
msgstr "-கள் அமைதியாக இருங்கள்"

msgid "-s                      Print service name if true"
msgstr "-s அச்சு சேவையின் பெயர் உண்மை எனில்"

msgid "-s                      Show a status summary"
msgstr "-கள் நிலை சுருக்கத்தைக் காட்டு"

msgid "-s SCOPE(S)                    Specify the scope(s) to authorize"
msgstr "-s SCOPE(S) அங்கீகரிக்கப்பட வேண்டிய நோக்கம்(களை) குறிப்பிடவும்"

msgid "-s cups-files.conf      Set cups-files.conf file to use."
msgstr "-s cups-files.conf பயன்படுத்த கப்ச்-files.conf கோப்பை அமைக்கவும்."

msgid "-s speed[,color-speed]  Set speed in pages per minute"
msgstr "-s வேகம்[,வண்ண வேகம்] வேகத்தை நிமிடத்திற்கு பக்கங்களில் அமைக்கவும்"

msgid "-t                      Produce a test report"
msgstr "-t ஒரு சோதனை அறிக்கையை உருவாக்கவும்"

msgid "-t                      Show all status information"
msgstr "-t அனைத்து நிலை தகவல்களையும் காட்டு"

msgid "-t                      Test the configuration file."
msgstr "-t உள்ளமைவு கோப்பை சோதிக்கவும்."

msgid ""
"-t TYPE                        Certificate type\n"
"                               (rsa-2048, rsa-3072, rsa-4096, ecdsa-p256, "
"ecdsa-p384, ecdsa-p521)"
msgstr ""
"-t வகை சான்றிதழ் வகை \n"
"(rsa-2048, rsa-3072, rsa-4096, ecdsa-p256, ecdsa-p384, ecdsa-p521)"

msgid "-t key                  True if the TXT record contains the key"
msgstr "-t விசை TXT பதிவில் விசை இருந்தால் சரி"

msgid "-t title                Specify the job title"
msgstr "-t தலைப்பு வேலை தலைப்பைக் குறிப்பிடவும்"

msgid ""
"-u USAGE                       Comma-delimited key usage\n"
"                               (digitalSignature, nonRepudiation, "
"keyEncipherment, dataEncipherment, keyAgreement, keyCertSign, cRLSign, "
"encipherOnly, decipherOnly, default-ca, default-tls)"
msgstr ""
"-u USAGE கமாவால் பிரிக்கப்பட்ட முக்கிய பயன்பாடு \n"
"(டிசிட்டல் கையொப்பம், மறுப்பு அல்லாதது, முக்கிய குறியாக்கம், தரவுக் குறியீடாக்கம், முக்கிய "
"ஒப்பந்தம், விசைப்பத்திரம், cRLSign, குறியாக்கம் மட்டும், புரிந்துகொள்வது மட்டும், default-"
"ca, default-tls)"

msgid ""
"-u [user(s)]            Show jobs queued by the current or specified users"
msgstr ""
"-u [பயனர்(கள்)] தற்போதைய அல்லது குறிப்பிட்ட பயனர்கள் வரிசையில் உள்ள வேலைகளைக் காட்டு"

msgid "-u allow:all            Allow all users to print"
msgstr "-u அனுமதி: அனைத்து பயனர்களையும் அச்சிட அனுமதிக்கவும்"

msgid ""
"-u allow:list           Allow the list of users or groups (@name) to print"
msgstr ""
"-u அனுமதி: பட்டியல் பயனர்கள் அல்லது குழுக்களின் (@பெயர்) பட்டியலை அச்சிட அனுமதிக்கவும்"

msgid ""
"-u deny:list            Prevent the list of users or groups (@name) to print"
msgstr ""
"-u deny:list பயனர்கள் அல்லது குழுக்களின் (@பெயர்) பட்டியலை அச்சிடுவதைத் தடுக்கவும்"

msgid "-u owner                Specify the owner to use for jobs"
msgstr "-u உரிமையாளர் வேலைகளுக்குப் பயன்படுத்த உரிமையாளரைக் குறிப்பிடவும்"

msgid "-u regex                Match URI to regular expression"
msgstr "-u வழக்கவெளி URIஐ வழக்கமான வெளிப்பாட்டுடன் பொருத்தவும்"

msgid "-v                      Be verbose"
msgstr "-v வாய்மொழியாக இருங்கள்"

msgid "-v                      Show devices"
msgstr "-v சாதனங்களைக் காட்டு"

msgid "-v [printer(s)]         Show the devices for each destination"
msgstr "-v [அச்சுப்பொறி(கள்)] ஒவ்வொரு இலக்குக்கான சாதனங்களைக் காட்டு"

msgid "-v device-uri           Specify the device URI for the printer"
msgstr "-v device-uri அச்சுப்பொறிக்கான சாதன யூரி ஐக் குறிப்பிடவும்"

msgid "-vv                     Be very verbose"
msgstr "-vv மிகவும் வாய்மொழியாக இருங்கள்"

msgid "-x                      Purge jobs rather than just canceling"
msgstr "-x ரத்து செய்வதை விட வேலைகளை சுத்தப்படுத்தவும்"

msgid "-x destination          Remove default options for destination"
msgstr "-x இலக்கு இலக்குக்கான இயல்புநிலை விருப்பங்களை அகற்று"

msgid "-x destination          Remove the named destination"
msgstr "-x இலக்கு பெயரிடப்பட்ட இலக்கை அகற்று"

msgid ""
